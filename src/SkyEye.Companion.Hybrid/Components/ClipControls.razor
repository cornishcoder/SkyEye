<section class="control-section clip-section" aria-label="Saved clips">
    <div class="clips-heading"><div><h2>Camera clips</h2><p class="hint" role="status">@Session.ClipStatus</p></div>
        <button class="icon-button refresh-button" disabled="@(Busy || Session.LoadingClips || !Session.CanLoadClips)" @onclick="Session.LoadClipsAsync" aria-label="Refresh camera clips" title="Refresh">↻</button>
    </div>
    <p class="hint">Watch a camera clip on TV with room audio, download it for offline use, or share it.</p>
    @if (Session.TransferringClip) { <button class="quiet" @onclick="Session.CancelClipTransfer">Cancel download</button> }
    @foreach (var clip in Session.RemoteClips)
    {
        <article class="clip" @key="@($"remote-{clip.Id}")">
            <p>@clip.Name <span class="hint">· @clip.Duration.ToString("0")s</span></p>
            @if (Session.SampleForClip(clip.Id) is { } sample)
            {
                <details><summary>Player-reported sample</summary>
                    <p>@sample.Report.OriginalWords</p>
                    @foreach (var field in sample.Report.Fields) { <p class="hint">@field.Kind: @field.Text</p> }
                    @foreach (var note in sample.Report.Notes) { <p class="hint">Note: @note</p> }
                    <p class="hint">The five-second target is not trimmed or source-timed. The camera clip is @sample.Clip!.Duration.ToString("0.0") seconds.</p>
                    <button class="secondary" @onclick="() => Session.ShareSampleMetadata(clip.Id)" aria-label="@($"Share sample metadata for {clip.Name}")">Share sample metadata</button>
                </details>
            }
            <button class="secondary" disabled="@(Busy || !Session.TvConnected || !Session.CanLoadClips)" @onclick="() => WatchTv.InvokeAsync(clip)" aria-label="@($"Watch {clip.Name} on TV")">Watch on TV</button>
            @if (clip.Available)
            {
                <p class="hint">Saved on this phone</p>
                <div class="clip-actions">
                    <button class="secondary" disabled="@Busy" @onclick="() => Play.InvokeAsync(clip.Id)" aria-label="@($"Play {clip.Name}")">Play</button>
                    <button class="secondary" disabled="@Busy" @onclick="() => Share.InvokeAsync(clip.Id)" aria-label="@($"Share {clip.Name}")">Share</button>
                </div>
            }
            else { <button class="secondary" disabled="@(Busy || Session.TransferringClip || !Session.CanLoadClips)" @onclick="() => Session.DownloadClipAsync(clip)" aria-label="@($"Download {clip.Name}")">Download portrait clip</button> }
        </article>
    }
    <h2 class="local-clips-heading">Saved on this phone</h2>
    @if (Session.LocalClips.Count == 0) { <p class="hint">Downloaded clips will appear here for offline viewing and sharing.</p> }
    @foreach (var clip in Session.LocalClips)
    {
        <article class="clip" @key="@($"local-{clip.Id}")">
            <p>@clip.Name <span class="hint">· available offline</span></p>
            <div class="clip-actions">
                <button class="secondary" disabled="@Busy" @onclick="() => Play.InvokeAsync(clip.Id)" aria-label="@($"Play {clip.Name}")">Play</button>
                <button class="secondary" disabled="@Busy" @onclick="() => Share.InvokeAsync(clip.Id)" aria-label="@($"Share {clip.Name}")">Share</button>
            </div>
        </article>
    }
</section>

@code {
    [Parameter, EditorRequired] public ShellSession Session { get; set; } = null!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> Share { get; set; }
    [Parameter] public EventCallback<ShellClipChoice> WatchTv { get; set; }
    [Parameter] public EventCallback<string> Play { get; set; }
}
