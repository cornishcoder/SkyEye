@using SkyEye.Core.Application
<section class="control-section" aria-label="Shot choices">
    <h2>Shot choices</h2>
    <p class="hint" role="status">@Session.CandidateStatus</p>
    <p class="hint">Phone: @Mode(Session.ShotPresentation.Phone) · TV: @(Session.TvReplaySelected ? Session.TvReplayKind : Mode(Session.ShotPresentation.Tv))</p>
    @if (Session.TvReplaySelected) { <p class="hint">TV choices appear when you play live on TV again.</p> }
    <label for="shot-screen">Apply to</label>
    <select id="shot-screen" @bind="target">
        <option value="@SceneTarget.Both">Phone and TV</option>
        <option value="@SceneTarget.Phone">Phone only</option>
        <option value="@SceneTarget.Tv">TV only</option>
    </select>
    <button class="primary" disabled="@(Busy || !Session.CanShowChoices)" @onclick="Cycle">Show candidate shots</button>
    <button class="secondary" disabled="@(Busy || !Session.CanAnalyzeTable)" @onclick="Session.ObserveTableAsync">Observe table once</button>
    <button class="secondary" disabled="@Busy" @onclick="Live">@(Session.TvReplaySelected ? "Clear candidates" : "Clear candidates · show live")</button>
    <p class="hint">Show requests one observation. If settlement is not established, ask again when the balls are still. Computed choices cycle every 2 seconds and expire after 15 seconds.</p>
    @{ var catalogVersion = Session.ChoiceTableVersion; }
    @foreach (var choice in Session.ShotChoices)
    {
        var number = Session.ShotChoices.ToList().IndexOf(choice) + 1;
        <button class="secondary" disabled="@Busy" @onclick="() => Pin(choice, catalogVersion)">Pin candidate @number · @choice.Type · pocket @(choice.Pocket + 1)</button>
        <button class="quiet" disabled="@Busy" @onclick="() => Session.ShowCuePathAsync(Version, catalogVersion, choice.Id)">Cue-ball path on phone · candidate @number</button>
        <div class="clip-actions">
            <button class="quiet" disabled="@Busy" @onclick="() => Hud(choice, catalogVersion, ShotAnnotations.Lines)">Just lines · @number</button>
            <button class="quiet" disabled="@Busy" @onclick="() => Hud(choice, catalogVersion, ShotAnnotations.WhiteDirection)">White direction · @number</button>
            <button class="quiet" disabled="@Busy" @onclick="() => Hud(choice, catalogVersion, ShotAnnotations.All)">Full shot · @number</button>
        </div>
    }
    <p class="hint">White direction assumes a stun collision. Its arrow shows direction only; a finish estimate needs pace and a validated model.</p>
</section>

@code {
    [Parameter, EditorRequired] public ShellSession Session { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public long Version { get; set; }
    SceneTarget target = SceneTarget.Both;
    static string Mode(SurfacePresentation surface) => surface.Mode switch { ShotDisplayMode.Cycling => "cycling choices", ShotDisplayMode.Pinned => "pinned choice", _ => "live" };
    Task Cycle() => Session.ShowRequestedChoicesAsync(Version, target);
    Task Live() => Session.SetShotDisplayAsync(Version, target, ShotDisplayMode.Live);
    Task Pin(ShotChoice choice, long catalogVersion) => Session.PinShotAsync(Version, target, catalogVersion, choice.Id);
    Task Hud(ShotChoice choice, long catalogVersion, ShotAnnotations elements) => Session.ShowHudAsync(Version, target, catalogVersion, choice.Id, elements);
}
