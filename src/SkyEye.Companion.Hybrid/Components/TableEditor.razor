<section class="editor" aria-label="Frozen table review">
    <h2>@(Session.TableEdit.Mode == TableEditMode.Calibration ? "Check table corners" : "Correct ball layout")</h2>
    <p class="hint" role="status">@Session.EditorHint</p>
    @if (Session.TableEdit.Mode == TableEditMode.Calibration)
    {
        <div class="clip-actions">
            <button class="secondary" disabled="@Busy" @onclick="() => Session.EditTable(e => e.ResetCorners())">Select corners</button>
            <button class="secondary" disabled="@(Busy || Session.TableEdit.Corners.Count == 0)" @onclick="() => Session.EditTable(e => e.UndoCorner())">Undo corner</button>
        </div>
    }
    else
    {
        <p class="colour-label">Ball colour</p>
        <div class="colour-choices" role="group" aria-label="Ball colour">
            @foreach (var colour in Colours)
            {
                <button class="@(Session.TableEdit.Kind == colour.Kind ? "primary" : "secondary")" disabled="@Busy"
                        aria-pressed="@(Session.TableEdit.Kind == colour.Kind ? "true" : "false")"
                        aria-label="@($"Choose {colour.Label.ToLowerInvariant()} ball")"
                        @onclick="() => Session.EditTable(e => e.SetKind(colour.Kind))">@colour.Label</button>
            }
        </div>
        <div class="clip-actions">
            <button class="secondary" disabled="@(Busy || Session.TableEdit.Balls.Count >= 16)" @onclick="() => Session.EditTable(e => e.AddBallMode())">Add ball</button>
            <button class="secondary" disabled="@(Busy || Session.TableEdit.Selected < 0)" @onclick="() => Session.EditTable(e => e.DeleteSelected())">Remove selected ball</button>
        </div>
    }
    <div class="clip-actions">
        <button class="primary" disabled="@(Busy || !Session.CanApplyTableEdit)" @onclick="Apply">@(Session.TableEdit.Mode == TableEditMode.Calibration ? "Use corners" : "Apply layout")</button>
        <button class="secondary" disabled="@Busy" @onclick="Session.CancelTableEdit">Cancel edit</button>
    </div>
    @if (Session.NeedsAttention)
    { <p class="notice" role="alert">@Session.Message</p><button class="quiet" @onclick="Session.DismissNotice">Dismiss message</button> }
</section>

@code {
    [Parameter, EditorRequired] public ShellSession Session { get; set; } = null!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback Apply { get; set; }
    static readonly (string Kind, string Label)[] Colours = [("red", "Red"), ("yellow", "Yellow"), ("cue", "Cue ball"), ("black", "Black")];
}
