@implements IDisposable
@inject ShellSession Session

<AgentBoundary Agent="Session.Agent">
    <SkyVoiceAgentBridge Session="Session" />
    <main class="shell app-shell">
        @if (Session.EditingTable)
        {
            <TableEditor Session="Session" Busy="busy" Apply="ApplyTable" />
        }
        else if (screen == Screen.Home)
        {
            <section class="home-panel" aria-label="SkyEye home">
                <header class="home-heading">
                    <div>
                        <span class="eyebrow">SKYEYE</span>
                        <p class="home-status" role="status">@HomeStatus</p>
                    </div>
                    <button class="home-menu-pin @(Session.SampleCollectionEnabled ? "is-pinned" : "")"
                        @onclick="Session.ToggleSampleCollection" aria-label="@Session.SampleCollectionLabel"
                        aria-pressed="@Session.SampleCollectionEnabled" title="@Session.SampleCollectionLabel">
                        <span>Samples @(Session.SampleCollectionEnabled ? "on" : "off")</span>
                    </button>
                    <button class="home-menu-pin @(Session.MenuPanelPinned ? "is-pinned" : "")"
                        @onclick="Session.ToggleMenuPanelPinned"
                        aria-label="@(Session.MenuPanelPinned ? "Unpin menu panel" : "Pin menu panel")"
                        aria-pressed="@Session.MenuPanelPinned"
                        title="@(Session.MenuPanelPinned ? "Unpin menu panel" : "Pin menu panel")">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3.5h8l-1.3 5.1 3 2.7v1.2h-5v7.9l-.7 1.1-.7-1.1v-7.9h-5v-1.2l3-2.7L8 3.5Z" /></svg>
                        <span>@(Session.MenuPanelPinned ? "Pinned" : "Auto-hide")</span>
                    </button>
                </header>

                <div class="home-actions" aria-label="Main actions">
                    <button class="home-icon-button settings-home-button" @onclick="() => Navigate(Screen.Settings)" aria-label="Settings" title="Settings">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm0-5.2 1.1 1.8 2.2.6 1.9-.7 1.5 1.5-.7 1.9.6 2.2 1.8 1.1v2.1l-1.8 1.1-.6 2.2.7 1.9-1.5 1.5-1.9-.7-2.2.6-1.1 1.8h-2.1l-1.1-1.8-2.2-.6-1.9.7-1.5-1.5.7-1.9-.6-2.2L1.5 13.5v-2.1l1.8-1.1.6-2.2-.7-1.9 1.5-1.5 1.9.7 2.2-.6L10 3h2Z" /></svg>
                        <span class="home-action-label">Settings</span>
                    </button>

                    <button class="home-icon-button sky-button @(Session.SkyConnected ? "selected" : "")" disabled="@busy" @onclick="SkyToggle" aria-label="@(Session.SkyConnected || Session.CanEndSky ? "End Sky conversation" : "Talk to Sky")" title="@(Session.SkyConnected || Session.CanEndSky ? "End Sky conversation" : "Talk to Sky")" aria-pressed="@(Session.SkyConnected || Session.CanEndSky)">
                        @if (Session.SkyConnected || Session.CanEndSky)
                        { <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.7 3.8 8 3.1a1.7 1.7 0 0 1 1.9 1l1.2 2.8a1.7 1.7 0 0 1-.4 1.9L9 10.4a14.1 14.1 0 0 0 4.6 4.6l1.6-1.7a1.7 1.7 0 0 1 1.9-.4l2.8 1.2a1.7 1.7 0 0 1 1 1.9l-.7 3.3a1.7 1.7 0 0 1-1.7 1.4C10.2 20.7 3.3 13.8 3.3 5.5a1.7 1.7 0 0 1 1.4-1.7Z" /><path d="m4 4 16 16" /></svg> }
                        else
                        { <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3m-4 0h8" /></svg> }
                        <span class="home-action-label">@(Session.SkyConnected || Session.CanEndSky ? "End Sky" : "Talk to Sky")</span>
                    </button>

                    @if (Session.SessionMode == TableSessionMode.Live)
                    {
                        <button class="home-icon-button end-session" disabled="@busy" @onclick="() => Run(Session.EndSessionAsync)" aria-label="End recording session" title="End recording session">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
                            <span class="home-action-label">End session</span>
                        </button>
                    }
                    else
                    {
                        <button class="home-icon-button live-session" disabled="@busy" @onclick="() => Run(Session.StartLiveSessionAsync)" aria-label="Start live session" title="Start live session">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="13" height="12" rx="2" /><path d="m16 10 5-3v10l-5-3z" /></svg>
                            <span class="home-action-label">Start live</span>
                        </button>
                        <button class="home-icon-button dark-session" disabled="@busy" @onclick="() => Run(Session.StartDarkSessionAsync)" aria-label="Start dark session" title="Start dark session">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.2 15.2A8.5 8.5 0 0 1 8.8 4.8 8.6 8.6 0 1 0 19.2 15.2Z" /></svg>
                            <span class="home-action-label">Start dark</span>
                        </button>
                    }

                    <button class="home-icon-button live-detect-shortcut @(Session.LiveDetectRunning ? "selected" : "")"
                        disabled="@(busy || !Session.CanToggleLiveDetect)"
                        @onclick="ToggleLiveDetect"
                        aria-label="@Session.LiveDetectShortcutLabel"
                        aria-pressed="@Session.LiveDetectRunning"
                        title="@Session.LiveDetectShortcutLabel">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="4.5" /><path d="M12 12 19 5M12 2v2m10 8h-2M12 22v-2M2 12h2" /></svg>
                        <span class="home-action-label">@Session.LiveDetectTileText</span>
                    </button>

                    <button class="home-icon-button live-detect-log-shortcut" @onclick="OpenLiveDetectLog"
                        aria-label="Open Live Detect log" title="Open Live Detect log">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5h14M5 10h14M5 14.5h14M5 19h14" /><circle cx="2.5" cy="5.5" r=".7" /><circle cx="2.5" cy="10" r=".7" /><circle cx="2.5" cy="14.5" r=".7" /><circle cx="2.5" cy="19" r=".7" /></svg>
                        <span class="home-action-label">Live Detect log</span>
                    </button>

                    <button class="home-icon-button candidate-shortcut @(Session.CandidateShortcutShown ? "selected" : "")"
                        disabled="@(busy || !Session.CanUseCandidateShortcut)"
                        @onclick="ToggleCandidateShortcut"
                        aria-label="@Session.CandidateShortcutLabel"
                        aria-pressed="@Session.CandidateShortcutShown"
                        title="@Session.CandidateShortcutLabel">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.3" /><path d="m15.4 15.4 5 5M8 10.8h5.6M10.8 8v5.6" /></svg>
                        <span class="home-action-label">@(Session.CheckingTable ? "Checking" : Session.CandidateShortcutShown ? "Hide shots" : "Show shots")</span>
                    </button>

                    <button class="home-icon-button capture-verifier-shortcut" disabled="@(busy || !Session.CanCaptureVerificationFrames)"
                        @onclick="() => Run(Session.CaptureVerificationFramesAsync)"
                        aria-label="@Session.VerificationCaptureLabel" aria-busy="@Session.VerificationCaptureRunning"
                        title="@Session.VerificationCaptureLabel">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7.5h4l1.6-2h4.8l1.6 2H20v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
                        <span class="home-action-label">@(Session.VerificationCaptureRunning ? "Capturing" : "Capture frames")</span>
                    </button>

                    @if (Session.SessionActive || Session.VisionDiagnosticLabelFrame is not null)
                    {
                        <button class="home-icon-button advisory-frame-shortcut" disabled="@busy"
                            @onclick="CaptureAdvisoryFrame" aria-label="@(Session.VisionDiagnosticLabelFrame is not null ? "Open advisory frame" : Session.CanCaptureAdvisoryFrame ? "Capture advisory frame" : $"Capture advisory frame: {Session.AdvisoryFrameUnavailableReason}")" title="@(Session.VisionDiagnosticLabelFrame is not null ? "Open advisory frame" : Session.CanCaptureAdvisoryFrame ? "Capture advisory frame" : Session.AdvisoryFrameUnavailableReason)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 15l2.5-3 2 2 2-3 2.5 4" /><circle cx="9" cy="9" r="1" /></svg>
                            <span class="home-action-label">GPT frame</span>
                        </button>
                    }

                    <button class="home-icon-button clips-button" @onclick="() => Navigate(Screen.Clips)" aria-label="Open clips" title="Open clips">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M7 5v4m5-4v4m5-4v4M7 15v4m5-4v4m5-4v4" /></svg>
                        <span class="home-action-label">Clips</span>
                    </button>

                    <button class="home-icon-button match-button" @onclick="() => Navigate(Screen.Match)" aria-label="Open match controls" title="Open match controls">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M12 8v8M7 9h1m-1 6h1m7-6h1m-1 6h1" /></svg>
                        <span class="home-action-label">Match</span>
                    </button>
                </div>

                @if (Session.HomeVerificationFeedbackVisible)
                { <p class="home-candidate-status" role="status" aria-live="polite">@Session.HomeVerificationStatus</p> }
                @if (Session.SessionActive && Session.VisionAdvisoryHomeFeedbackVisible)
                { <p class="home-candidate-status" role="status" aria-live="polite">@Session.VisionDiagnosticLabelStatus</p> }
                @if (Session.SampleCollectionStatus.Length > 0)
                { <p class="home-candidate-status" role="status" aria-live="polite">@Session.SampleCollectionStatus</p> }
                @if (Session.LiveDetectFeedbackVisible)
                {
                    <section class="home-live-detect" aria-label="Live detection status">
                        <p role="status" aria-live="polite">@Session.LiveDetectStatus</p>
                        @if (Session.LiveDetectInventory.Length > 0)
                        { <p class="live-detect-inventory">@Session.LiveDetectInventory · analyzed @Session.LiveDetectReadAt</p> }
                    </section>
                }
                <p class="physics-status" role="status"><span class="status-dot @(Session.PhysicsAvailable ? "ready" : "off")"></span>@HomePhysicsStatus</p>
                @if (error.Length > 0) { <p class="notice" role="alert">@error</p> }
                @if (Session.NeedsAttention)
                { <div class="home-message" role="status"><span>@Session.Message</span><button class="quiet" @onclick="Session.DismissNotice">Dismiss</button></div> }
            </section>
        }
        else
        {
            <section class="screen-panel" aria-label="@ScreenTitle">
                <header class="screen-heading">
                    <button class="icon-button back-button" @onclick="() => Navigate(Screen.Home)" aria-label="Back to home" title="Back">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
                    </button>
                    <div><span class="eyebrow">SKYEYE</span><h1>@ScreenTitle</h1></div>
                    @if (screen == Screen.Settings)
                    { <span class="settings-physics">@Session.PhysicsStatus</span> }
                </header>

                @if (screen == Screen.LiveDetectLog)
                {
                    <section class="control-section live-detect-log-screen" aria-label="Live Detect activity">
                        <h2>Current status</h2>
                        <p class="hint" role="status" aria-live="polite">@Session.LiveDetectStatus</p>
                        @if (Session.LiveDetectInventory.Length > 0)
                        { <p class="live-detect-inventory">@Session.LiveDetectInventory · analyzed @Session.LiveDetectReadAt</p> }
                        <p class="hint">@Session.LiveDetectClipStatus</p>
                        <p class="hint live-detect-log-status">@Session.LiveDetectLogStatus</p>
                        <h2 class="live-detect-events-heading">Recent table events</h2>
                        @if (Session.LiveDetectEvents.Count == 0)
                        {
                            <p class="hint" role="status">No table events recorded during this Live Detect run.</p>
                        }
                        else
                        {
                            <ol class="live-detect-event-list" role="log" aria-label="Recent Live Detect events" aria-live="polite">
                                @foreach (var item in Session.LiveDetectEvents)
                                { <li>@item</li> }
                            </ol>
                        }
                    </section>
                }
                else if (screen == Screen.Settings)
                {
                    <section class="control-section camera-settings" aria-label="Camera and recording">
                        <h2>Camera and recording</h2>
                        <p class="camera-state" role="status">@Session.Agent.State.Value.Camera · @Session.Agent.State.Value.Connection.Capture</p>
                        <button class="secondary" disabled="@(busy || Session.FindingCamera)" @onclick="Find">@(Session.FindingCamera ? "Finding cameras…" : "Find camera")</button>
                        @foreach (var camera in Session.Cameras)
                        { <button class="secondary" disabled="@busy" @onclick="() => SelectCamera(camera)">@camera.Name</button> }
                        <label for="camera-address">Camera address</label>
                        <input id="camera-address" type="url" inputmode="url" autocomplete="off" spellcheck="false" @bind="address" />
                        <button class="primary" disabled="@busy" @onclick="Connect">@(busy ? "Connecting…" : "Connect camera")</button>
                        <CameraControls View="Session.Agent.State.Value" Busy="busy" HostName="Session.HostName" OnCommand="Control" />
                        <button class="secondary" disabled="@(busy || !Session.CanCastLive)" @onclick="Watch">Watch live on this phone</button>
                    </section>

                    <details class="settings-group" open>
                        <summary>Table analysis and shot display</summary>
                        <TableControls Session="Session" Busy="busy" Version="Session.Agent.State.Value.Version" Calibrate="CalibrateTable" Correct="CorrectTable" />
                        <ShotControls Session="Session" Busy="busy" Version="Session.Agent.State.Value.Version" />
                    </details>

                    <details class="settings-group">
                        <summary>TV and Chromecast</summary>
                        <section class="control-section" aria-label="TV viewing" tabindex="-1" @ref="tvSection">
                            <h2>TV</h2><p class="hint" role="status">@Session.TvStatus</p>
                            @if (Session.TvReplaySelected) { <p class="hint" role="status">@Session.TvReplayProgress</p> }
                            <TvReplayControls Session="Session" Busy="@(busy || Session.PreparingRecentReplay)" />
                            @if (Session.TvLiveConfirmation.Length > 0) { <p class="hint" role="status">@Session.TvLiveConfirmation</p> }
                            <button class="secondary" disabled="@busy" @onclick="ChooseTv">Choose TV</button>
                            <button class="secondary" disabled="@(busy || !Session.CanCastLive || !Session.TvConnected)" @onclick="Session.PlayTv">Play live on TV</button>
                            <p class="hint">@(Session.HasTableCalibration ? "TV shows the corrected table with SkyEye branding." : "SkyEye branding is on. Calibrate the table for its corrected TV view.")</p>
                            <button class="quiet" disabled="@(busy || !Session.TvConnected)" @onclick="Session.StopTv">Disconnect TV</button>
                        </section>
                    </details>

                    <details class="settings-group">
                        <summary>Sky voice and conversation</summary>
                        <section class="control-section" aria-label="Personal voice setup">
                            <p class="hint" role="status">@Session.KeyStatus</p>
                            <p class="hint">Your personal key stays on this phone.</p>
                            <p class="hint" role="status" aria-live="polite">@Session.SkyStatus</p>
                            @if (Session.SkyToolStatus.Length > 0) { <p class="hint" role="status">@Session.SkyToolStatus</p> }
                            <button class="primary" disabled="@(busy || !Session.CanEditSkyKey)" @onclick="SetupKey">@(Session.PersonalKeyConfigured ? "Replace personal key" : "Set personal key")</button>
                            <button class="secondary" disabled="@(busy || !Session.CanMuteSky)" @onclick="Session.ToggleSkyMute">@(Session.SkyMuted ? "Unmute microphone" : "Mute microphone")</button>
                            @if (Session.PersonalKeyConfigured) { <button class="quiet" disabled="@(busy || !Session.CanEditSkyKey)" @onclick="RemoveKey">Remove personal key</button> }
                            @if (Session.SkyState != SkyEye.Companion.SkyVoiceState.Disconnected || Session.SkyTranscript.Length > 0)
                            {
                                <div class="sky-conversation" aria-label="Sky conversation">
                                    @if (Session.SkyTranscript.Length > 0) { <p class="sky-message" aria-live="polite">@Session.SkyTranscript</p> }
                                    <MessageList>
                                        <EmptyContent>@if (Session.SkyTranscript.Length == 0) { <p class="hint">Your Sky conversation will appear here.</p> }</EmptyContent>
                                        <ChildContent>
                                            <BlockRenderer TBlock="RichContentBlock" Context="block"><p class="sky-message">@block.RawText</p></BlockRenderer>
                                            <BlockRenderer TBlock="FunctionInvocationContentBlock" Context="block">
                                                <details class="sky-tool"><summary>@block.ToolName · @(block.HasResult ? "complete" : "working")</summary><pre>@block.Arguments</pre>@if (block.HasResult) { <pre>@block.Result</pre> }</details>
                                            </BlockRenderer>
                                        </ChildContent>
                                    </MessageList>
                                </div>
                            }
                        </section>
                    </details>

                    @if (Session.HasMoreControls)
                    {
                        <details class="settings-group"><summary>Advanced camera controls</summary>
                            <p class="hint">Open the dedicated controls for additional camera settings.</p>
                            <button class="secondary" disabled="@(busy || Session.TransferringClip)" @onclick="MoreControls">Open advanced controls</button>
                        </details>
                    }
                    @if (Session.IsLab)
                    {
                        <details class="settings-group lab-tools"><summary>Lab checks</summary>
                            <button class="secondary" disabled="@busy" @onclick="Preview">Play test video</button><p class="hint">A recorded playback check, separate from your live table.</p>
                            <button class="secondary" disabled="@(!Session.CanFrameTable)" @onclick="Session.ToggleFrameGuides">@(Session.FrameGuides ? "Hide framing guides" : "Show framing guides")</button><p class="hint">Alignment guides for this lab. They are not shot suggestions.</p>
                            <button class="secondary" disabled="@(!Session.SceneCheck && !Session.CanSceneCheck)" @onclick="SceneCheck">@(Session.SceneCheck ? "Clear scene check" : "Show scene check")</button><p class="hint">@Session.SceneCheckStatus</p>
                            <button class="secondary" disabled="@(!Session.CanSceneCheck || busy)" @onclick="JournalCheck">Check annotation journal</button>
                            <button class="secondary" disabled="@(!Session.CanSceneCheck || busy)" @onclick="AnnotatedExportCheck">Check annotated replay export</button>
                        </details>
                    }
                }
                else if (screen == Screen.Clips)
                {
                    <ClipControls Session="Session" Busy="busy" Share="ShareClip" WatchTv="WatchClipOnTv" Play="PlayClip" />
                    <RecentReplayControls Session="Session" Busy="@(busy || Session.PreparingRecentReplay)" Prepare="PrepareRecentReplay" Watch="WatchRecentReplay" />
                }
                else if (screen == Screen.Match)
                {
                    <p class="hint">Sky can update the score from clear player conversation. Image analysis never decides a pot, foul or winner.</p>
                    <MatchControls Session="Session" Busy="busy" />
                }
                else if (screen == Screen.Advisory)
                {
                    @if (Session.VisionDiagnosticLabelFrame is null)
                    {
                        <p class="hint" role="status">@Session.VisionDiagnosticLabelStatus</p>
                        <p class="hint">This uses one fresh frame from the active calibrated live session. It never starts recording.</p>
                    }
                    else
                    {
                        <VisionDiagnosticLabeler Session="Session" />
                    }
                }

                @if (error.Length > 0) { <p class="notice" role="alert">@error</p> }
                @if (Session.NeedsAttention) { <p class="notice" role="status">@Session.Message</p> }
            </section>
        }
    </main>
</AgentBoundary>

@code {
    enum Screen { Home, Settings, Clips, Match, Advisory, LiveDetectLog }
    Screen screen = Screen.Home;
    string address = "", lastSavedAddress = "", error = "";
    bool busy, disposed;
    protected override void OnInitialized() { address = lastSavedAddress = Session.SavedAddress; Session.Changed += Changed; Session.NavigationRequested += NavigateFromControl; Session.SetUiScreen("home"); }
    string ScreenTitle => screen switch { Screen.Settings => "Settings", Screen.Clips => "Clips", Screen.Match => "Match", Screen.Advisory => "Frame advisory", Screen.LiveDetectLog => "Live Detect log", _ => "Home" };
    string HomeStatus => Session.SessionMode switch
    {
        TableSessionMode.Dark => "Dark session · camera recording",
        TableSessionMode.Live => "Live session · " + Session.Agent.State.Value.Camera,
        _ => Session.Agent.State.Value.Camera
    };
    string HomePhysicsStatus => Session.PhysicsAvailable ? "Physics available" : Session.SessionMode == TableSessionMode.Dark ? "Physics unavailable · dark session" : "Physics unavailable";
    void Changed() { if (!disposed) _ = InvokeAsync(() => { var saved = Session.SavedAddress; if (saved != lastSavedAddress) address = lastSavedAddress = saved; StateHasChanged(); }); }
    void Navigate(Screen target)
    {
        screen = target;
        Session.SetUiScreen(target == Screen.LiveDetectLog ? "live-detect-log" : target.ToString().ToLowerInvariant());
        error = "";
        Session.SetSheet(target != Screen.Home);
        if (target == Screen.Clips) _ = Session.LoadClipsAsync();
    }
    void NavigateFromControl(string target)
    {
        if (string.Equals(target, "live-detect-log", StringComparison.OrdinalIgnoreCase)) Navigate(Screen.LiveDetectLog);
        else if (Enum.TryParse<Screen>(target, true, out var parsed) && Enum.IsDefined(parsed)) Navigate(parsed);
    }
    void OpenLiveDetectLog() => Navigate(Screen.LiveDetectLog);
    async Task Connect() => await Run(() => Session.ConnectAsync(address));
    async Task SceneCheck() => await Run(Session.ToggleSceneCheckAsync);
    async Task AnnotatedExportCheck() => await Run(Session.CheckAnnotatedExportAsync);
    async Task JournalCheck() => await Run(Session.CheckAnnotationJournalAsync);
    async Task Preview() => await Run(Session.FixtureAsync);
    async Task Find() => await Run(Session.FindCamerasAsync);
    async Task SelectCamera(CameraChoice camera) { address = camera.Address; await Connect(); }
    async Task Control(CameraControlRequest request) => await Run(() => Session.ControlCameraAsync(request));
    async Task ToggleCandidateShortcut() => await Run(Session.ToggleCandidateShortcutAsync);
    async Task ToggleLiveDetect() => await Run(Session.ToggleLiveDetectAsync);
    async Task CaptureAdvisoryFrame()
    {
        if (Session.VisionDiagnosticLabelFrame is not null) { Navigate(Screen.Advisory); return; }
        var requested = false;
        await Run(async () => requested = await Session.CaptureAdvisoryFrameAsync());
        if (requested) Navigate(Screen.Advisory);
    }
    async Task Watch() => await Run(Session.WatchLiveAsync, goHome: true);
    async Task SkyToggle() { if (Session.SkyConnected || Session.CanEndSky) await Run(Session.EndSkyAsync); else await Run(Session.StartSkyAsync); }
    async Task ChooseTv() => await Run(Session.ChooseTvAsync);
    async Task ShareClip(string id) => await Run(() => Session.ShareClipAsync(id));
    async Task PlayClip(string id) => await Run(() => Session.PlayClipAsync(id), goHome: true);
    ElementReference tvSection;
    async Task PrepareRecentReplay(int seconds)
    {
        await Run(() => Session.RecentReplayAsync(seconds));
        if (Session.TvReplaySelected && screen == Screen.Settings) await tvSection.FocusAsync();
    }
    async Task WatchRecentReplay() => Session.WatchRecentReplay();
    async Task WatchClipOnTv(ShellClipChoice clip) => await Run(() => Session.PlayClipOnTvAsync(clip));
    async Task SetupKey() => await Run(Session.SetupKeyAsync);
    async Task RemoveKey() => await Run(Session.RemoveSkyKeyAsync);
    async Task MoreControls() => await Run(Session.MoreControlsAsync);
    async Task CalibrateTable() => await Run(Session.CalibrateTableAsync);
    async Task CorrectTable() => await Run(Session.CorrectTableAsync);
    async Task ApplyTable() => await Run(Session.ApplyTableEditAsync, goHome: true);
    async Task Run(Func<Task> action, bool goHome = false)
    {
        if (busy) return;
        busy = true; error = "";
        try
        {
            await action();
            if (!disposed && goHome && Session.HasSource)
            {
                screen = Screen.Home;
                Session.SetSheet(false);
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception) { error = "The request could not finish. Check the connection and try again."; Session.ShowError(error); }
        finally { busy = false; }
    }
    public void Dispose() { disposed = true; Session.Changed -= Changed; Session.NavigationRequested -= NavigateFromControl; }
}
