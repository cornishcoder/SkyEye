@implements IDisposable
@inject ShellSession Session

<AgentBoundary Agent="Session.Agent">
    <main class="shell @(Session.SheetOpen ? "expanded" : "")">
        @if (Session.EditingTable)
        {
            <TableEditor Session="Session" Busy="busy" Apply="ApplyTable" />
        }
        else
        {
        @if (Session.SheetOpen)
        {
            <section class="sheet" aria-label="Table controls">
                <div class="sheet-heading"><h1>Your table</h1><button class="quiet" @onclick="Close" aria-label="Close controls">Close</button></div>
                <p class="camera-state" role="status">@Session.Agent.State.Value.Camera</p>
                <MatchControls Session="Session" Busy="busy" />
                <section class="control-section" aria-label="Camera connection">
                <h2>Camera</h2>
                <button class="secondary" disabled="@(busy || Session.FindingCamera)" @onclick="Find">@(Session.FindingCamera ? "Finding cameras…" : "Find camera")</button>
                @foreach (var camera in Session.Cameras)
                { <button class="secondary" disabled="@busy" @onclick="() => SelectCamera(camera)">@camera.Name</button> }
                <label for="camera-address">Camera address</label>
                <input id="camera-address" type="url" inputmode="url" autocomplete="off" spellcheck="false" @bind="address" />
                <button class="primary" disabled="@busy" @onclick="Connect">@(busy ? "Connecting…" : "Connect camera")</button>
                </section>
                <CameraControls View="Session.Agent.State.Value" Busy="busy" HostName="Session.HostName" OnCommand="Control" />
                <section class="control-section" aria-label="Live viewing">
                <h2>Live table</h2><p class="hint" role="status">@Session.LiveAvailability</p>
                <button class="secondary" disabled="@(busy || !Session.CanCastLive)" @onclick="Watch">Watch live</button>
                @if (Session.HasSource) { <button class="quiet" @onclick="Session.Stop">Stop viewing</button> }
                <p class="hint" role="status">@Session.FramingStatus</p>
                <button class="secondary" disabled="@(busy || !Session.CanFrameTable && !Session.FrameTableRequested)" @onclick="() => Session.SetTableFraming(!Session.FrameTableRequested)">@(Session.FrameTableRequested ? "Show whole camera" : "Rectangular table")</button>
                </section>
                <ShotControls Session="Session" Busy="busy" Version="Session.Agent.State.Value.Version" />
                <section class="control-section" aria-label="TV viewing" tabindex="-1" @ref="tvSection">
                <h2>TV</h2><p class="hint" role="status">@Session.TvStatus</p>
                @if (Session.TvReplaySelected) { <p class="hint" role="status">@Session.TvReplayProgress</p> }
                <TvReplayControls Session="Session" Busy="@(busy || Session.PreparingRecentReplay)" />
                @if (Session.TvLiveConfirmation.Length > 0) { <p class="hint" role="status">@Session.TvLiveConfirmation</p> }
                <button class="secondary" disabled="@busy" @onclick="ChooseTv">Choose TV</button>
                <button class="secondary" disabled="@(busy || !Session.CanCastLive || !Session.TvConnected)" @onclick="Session.PlayTv">Play live on TV</button>
                <button class="secondary" disabled="@(busy || !Session.CanCastLive)" @onclick="() => Session.SetTvCorrectionAsync(!Session.TvCorrectionRequested)">@(Session.TvCorrectionRequested ? "Original live TV view" : "Corrected and branded TV view")</button>
                <p class="hint">Original live TV uses camera framing. The corrected and branded view follows your stored calibration. Phone correction is independent.</p>
                <button class="quiet" disabled="@(busy || !Session.TvConnected)" @onclick="Session.StopTv">Disconnect TV</button>
                </section>
                <TableControls Session="Session" Busy="busy" Version="Session.Agent.State.Value.Version" Calibrate="CalibrateTable" Correct="CorrectTable" Confirm="ConfirmTable" />
                <RecentReplayControls Session="Session" Busy="busy" Prepare="PrepareRecentReplay" Watch="WatchRecentReplay" />
                <ClipControls Session="Session" Busy="busy" Share="ShareClip" WatchTv="WatchClipOnTv" />
                <section class="control-section" aria-label="Personal voice setup">
                <h2>Sky voice</h2><p class="hint" role="status">@Session.KeyStatus</p>
                <p class="hint">Your personal key stays on this phone.</p>
                <button class="secondary" disabled="@busy" @onclick="SetupKey">@(Session.PersonalKeyConfigured ? "Replace personal key" : "Set personal key")</button>
                @if (Session.PersonalKeyConfigured) { <button class="quiet" disabled="@busy" @onclick="Session.RemoveKey">Remove personal key</button> }
                </section>
                @if (Session.HasMoreControls)
                {
                    <section class="control-section" aria-label="More controls">
                        <h2>More controls</h2>
                        <p class="hint">Save recent recording, candidate shots and voice.</p>
                        <button class="secondary" disabled="@(busy || Session.TransferringClip)" @onclick="MoreControls">More controls</button>
                    </section>
                }
                @if (error.Length > 0) { <p class="notice" role="alert">@error</p> }
                @if (Session.IsLab) { <details class="lab-tools"><summary>Lab checks</summary><button class="secondary" disabled="@busy" @onclick="Preview">Play test video</button><p class="hint">A recorded playback check, separate from your live table.</p><button class="secondary" disabled="@(!Session.CanFrameTable)" @onclick="Session.ToggleFrameGuides">@(Session.FrameGuides ? "Hide framing guides" : "Show framing guides")</button><p class="hint">Alignment guides for this lab. They are not shot suggestions.</p><button class="secondary" disabled="@(!Session.SceneCheck && !Session.CanSceneCheck)" @onclick="SceneCheck">@(Session.SceneCheck ? "Clear scene check" : "Show scene check")</button><p class="hint">@Session.SceneCheckStatus</p><button class="secondary" disabled="@(!Session.CanSceneCheck || busy)" @onclick="JournalCheck">Check annotation journal</button><button class="secondary" disabled="@(!Session.CanSceneCheck || busy)" @onclick="AnnotatedExportCheck">Check annotated replay export</button></details> }
            </section>
        }
        @if (Session.ControlsVisible)
        {
        <footer class="dock">
            <MatchHud Match="Session.Match" />
            <div class="sky"><span class="sky-orb" aria-hidden="true"></span><div><strong>Sky</strong><span role="status">@Session.Playback</span></div></div>
            <button class="controls" @onclick="Toggle" aria-expanded="@Session.SheetOpen" aria-label="@(Session.SheetOpen ? "Close table controls" : "Open table controls")">@(Session.SheetOpen ? "Hide" : "Controls") <span aria-hidden="true">⌃</span></button>
            <p class="message" role="status">@Session.Message</p>
            @if (Session.NeedsAttention) { <button class="quiet acknowledge" @onclick="Session.DismissNotice">Dismiss message</button> }
        </footer>
        }
        else
        {
            <footer class="resting"><MatchHud Match="Session.Match" /><button class="sky-rest" @onclick="Session.RevealControls" aria-label="Show table controls"><span class="sky-orb" aria-hidden="true"></span>Sky</button></footer>
        }
        }
    </main>
</AgentBoundary>

@code {
    string address = "", lastSavedAddress = "", error = "";
    bool busy, disposed;
    protected override void OnInitialized() { address = lastSavedAddress = Session.SavedAddress; Session.Changed += Changed; }
    void Changed() { if (!disposed) _ = InvokeAsync(() => { var saved = Session.SavedAddress; if (saved != lastSavedAddress) address = lastSavedAddress = saved; StateHasChanged(); }); }
    void Toggle() => Session.SetSheet(!Session.SheetOpen);
    void Close() => Session.SetSheet(false);
    async Task Connect() => await Run(() => Session.ConnectAsync(address), close: true);
    async Task SceneCheck() => await Run(Session.ToggleSceneCheckAsync);
    async Task AnnotatedExportCheck() => await Run(Session.CheckAnnotatedExportAsync);
    async Task JournalCheck() => await Run(Session.CheckAnnotationJournalAsync);
    async Task Preview() => await Run(Session.FixtureAsync, close: true);
    async Task Find() => await Run(Session.FindCamerasAsync);
    async Task SelectCamera(CameraChoice camera) { address = camera.Address; await Connect(); }
    async Task Control(CameraControlRequest request) => await Run(() => Session.ControlCameraAsync(request));
    async Task Watch() => await Run(Session.WatchLiveAsync, close: true);
    async Task ChooseTv() => await Run(Session.ChooseTvAsync);
    async Task ShareClip(string id) => await Run(() => Session.ShareClipAsync(id));
    ElementReference tvSection;
    async Task PrepareRecentReplay(int seconds)
    {
        await Run(() => Session.RecentReplayAsync(seconds));
        if (Session.TvReplaySelected) await tvSection.FocusAsync();
    }
    async Task WatchRecentReplay()
    {
        Session.WatchRecentReplay();
        if (Session.TvReplaySelected) await tvSection.FocusAsync();
    }
    async Task WatchClipOnTv(ShellClipChoice clip)
    {
        await Run(()=>Session.PlayClipOnTvAsync(clip));
        if (Session.TvReplaySelected) await tvSection.FocusAsync();
    }
    async Task SetupKey() => await Run(Session.SetupKeyAsync);
    async Task MoreControls() => await Run(Session.MoreControlsAsync);
    async Task CalibrateTable() => await Run(Session.CalibrateTableAsync);
    async Task CorrectTable() => await Run(Session.CorrectTableAsync);
    async Task ConfirmTable() => await Run(Session.ConfirmTableAsync);
    async Task ApplyTable() => await Run(Session.ApplyTableEditAsync);
    async Task Run(Func<Task> action, bool close = false)
    {
        if (busy) return;
        busy = true; error = "";
        try { await action(); if (!disposed && close && Session.HasSource) Close(); }
        catch (OperationCanceledException) { }
        catch (Exception) { error = "The request could not finish. Check the connection and try again."; Session.ShowError(error); }
        finally { busy = false; }
    }
    public void Dispose() { disposed = true; Session.Changed -= Changed; }
}
