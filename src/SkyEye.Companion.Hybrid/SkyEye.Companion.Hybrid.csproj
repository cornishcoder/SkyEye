<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <RootNamespace>SkyEye.Companion.Hybrid</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiVersion>11.0.0-rc.1.26451.6</MauiVersion>
    <ApplicationTitle>SkyEye Lab</ApplicationTitle>
    <ApplicationId>uk.co.skyeye.companion.lab</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\work\android-sdk-11')">$(MSBuildThisFileDirectory)..\..\work\android-sdk-11</AndroidSdkDirectory>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidManifestPlaceholders>skyeyeFileProvider=$(ApplicationId).files</AndroidManifestPlaceholders>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SkyEyeProduction)' == 'true'">
    <ApplicationTitle>SkyEye</ApplicationTitle>
    <ApplicationId>uk.co.skyeye.companion</ApplicationId>
    <ApplicationDisplayVersion>0.8.40</ApplicationDisplayVersion>
    <ApplicationVersion>48</ApplicationVersion>
    <DefineConstants>$(DefineConstants);SKYEYE_HYBRID_PRODUCTION</DefineConstants>
    <AndroidManifestPlaceholders>skyeyeFileProvider=$(ApplicationId).files</AndroidManifestPlaceholders>
  </PropertyGroup>
  <ItemGroup Condition="'$(SkyEyeProduction)' == 'true'">
    <!-- Preserve existing save, candidates and voice workflows until their new UI adapters land. -->
    <Compile Include="../SkyEye.Companion/*.cs" Exclude="../SkyEye.Companion/CameraClient.cs;../SkyEye.Companion/CameraClipSaveEffect.cs;../SkyEye.Companion/CameraControlEffect.cs;../SkyEye.Companion/CameraReadEffects.cs;../SkyEye.Companion/CompanionClipService.cs;../SkyEye.Companion/AndroidEffectAdapters.cs;../SkyEye.Companion/AndroidRecordedGeometry.cs;../SkyEye.Companion/AndroidRecordedRenderer.cs;../SkyEye.Companion/AndroidCorrectedClipRenderer.cs;../SkyEye.Companion/CompanionCorrectedClips.cs;../SkyEye.Companion/SecretStore.cs;../SkyEye.Companion/MigrationAudit.cs;../SkyEye.Companion/OverlayRelay.cs;../SkyEye.Companion/PlayerTableFrameSource.cs;../SkyEye.Companion/SkyVoiceSession.cs;../SkyEye.Companion/VoiceService.cs" Link="MoreControls/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/companion_icon.png" ForegroundScale="0.72" Color="#0A131C" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#0A131C" BaseSize="128,128" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.AI" Version="0.1.0-preview.1.26466.103" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.10.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.UI" Version="1.10.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Transformer" Version="1.10.1.1" />
    <PackageReference Include="Xamarin.GooglePlayServices.Cast.Framework" Version="122.3.1.2" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <AndroidMavenLibrary Include="io.github.webrtc-sdk:android" Version="150.7871.01" Bind="false" />
    <ProjectReference Include="../SkyEye.Vision.Android/SkyEye.Vision.Android.csproj" />
    <ProjectReference Include="../SkyEye.Observation/SkyEye.Observation.csproj" />
    <Compile Include="../SkyEye.Companion/SkyVoiceSession.cs" Link="Services/SkyVoiceSession.cs" />
    <Compile Include="../SkyEye.Companion/VoiceService.cs" Link="Services/VoiceService.cs" />
    <AndroidJavaSource Include="../SkyEye.Companion/SkyEyeRtcSession.java" Link="Native/SkyEyeRtcSession.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/AnnotationRecorder.java" Link="Native/AnnotationRecorder.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/WatermarkRenderer.java" Link="Native/WatermarkRenderer.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/PlayerBridge.java" Link="Native/PlayerBridge.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/DecodedFrameLedger.java" Link="Native/DecodedFrameLedger.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/DecodedFrameSnapshot.java" Link="Native/DecodedFrameSnapshot.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/CandidateOverlay.java" Link="Native/CandidateOverlay.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/TableSceneOverlay.java" Link="Native/TableSceneOverlay.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/OverlayEncoder.java" Link="Native/OverlayEncoder.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/LiveGpuCompositor.java" Link="Native/LiveGpuCompositor.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/OverlayTsWriter.java" Link="Native/OverlayTsWriter.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/CastBridge.java" Link="Native/CastBridge.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/DiscoveryBridge.java" Link="Native/DiscoveryBridge.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/PortraitExporter.java" Link="Native/PortraitExporter.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/RecordedFrameReader.java" Link="Native/RecordedFrameReader.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/RecordedSceneOverlay.java" Link="Native/RecordedSceneOverlay.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/RecordedVideoRenderer.java" Link="Native/RecordedVideoRenderer.java" />
    <AndroidJavaSource Include="../SkyEye.Companion/SkyEyeCastOptions.java" Link="Native/SkyEyeCastOptions.java" />
    <AndroidJavaSource Include="NativeCompatibilityProbe.java" />
    <Compile Include="../SkyEye.Companion/CameraClient.cs" Link="Services/CameraClient.cs" />
    <Compile Include="../SkyEye.Companion/CameraClipSaveEffect.cs" Link="Services/CameraClipSaveEffect.cs" />
    <Compile Include="../SkyEye.Companion/CameraControlEffect.cs" Link="Services/CameraControlEffect.cs" />
    <Compile Include="../SkyEye.Companion/CameraReadEffects.cs" Link="Services/CameraReadEffects.cs" />
    <Compile Include="../SkyEye.Companion/PlayerTableFrameSource.cs" Link="Services/PlayerTableFrameSource.cs" />
    <Compile Include="../SkyEye.Companion/CompanionClipService.cs" Link="Services/CompanionClipService.cs" />
    <Compile Include="../SkyEye.Companion/AndroidEffectAdapters.cs" Link="Services/AndroidEffectAdapters.cs" />
    <Compile Include="../SkyEye.Companion/AndroidRecordedGeometry.cs" Link="Services/AndroidRecordedGeometry.cs" />
    <Compile Include="../SkyEye.Companion/AndroidRecordedRenderer.cs" Link="Services/AndroidRecordedRenderer.cs" />
    <Compile Include="../SkyEye.Companion/AndroidCorrectedClipRenderer.cs" Link="Services/AndroidCorrectedClipRenderer.cs" />
    <Compile Include="../SkyEye.Companion/CompanionCorrectedClips.cs" Link="Services/CompanionCorrectedClips.cs" />
    <Compile Include="../SkyEye.Companion/SecretStore.cs" Link="Services/SecretStore.cs" />
    <Compile Include="../SkyEye.Companion/MigrationAudit.cs" Link="Services/MigrationAudit.cs" />
    <Compile Include="../SkyEye.Companion/OverlayRelay.cs" Link="Services/OverlayRelay.cs" />
    <AndroidResource Include="../SkyEye.Companion/Resources/xml/file_paths.xml" Link="Resources/xml/file_paths.xml" />
    <MauiAsset Include="Resources/Raw/probe.mp4" LogicalName="probe.mp4" />
    <MauiAsset Include="Resources/Raw/vision-diagnostics-dashboard.html" LogicalName="vision-diagnostics-dashboard.html" />
    <MauiAsset Include="Resources/Raw/vision-scenario-lab.html" LogicalName="vision-scenario-lab.html" />
  </ItemGroup>
  <ItemGroup><AndroidAsset Include="../../watermark.png" Link="watermark.png" /></ItemGroup>
</Project>
