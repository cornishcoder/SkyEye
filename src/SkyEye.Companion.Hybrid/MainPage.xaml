<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SkyEye.Companion.Hybrid"
             xmlns:components="clr-namespace:SkyEye.Companion.Hybrid.Components"
             x:Class="SkyEye.Companion.Hybrid.MainPage">

    <Grid RowDefinitions="240,*">
    <local:NativeMediaView />
    <BlazorWebView Grid.Row="1" x:Name="blazorWebView" HostPage="wwwroot/index.html" BackgroundColor="Transparent" BlazorWebViewInitialized="WebViewInitialized">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
    </Grid>

</ContentPage>
