<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SkyEye.Companion.Hybrid"
             xmlns:components="clr-namespace:SkyEye.Companion.Hybrid.Components"
             x:Class="SkyEye.Companion.Hybrid.MainPage" BackgroundColor="Black">

    <Grid>
    <local:NativeMediaView x:Name="mediaView" ZIndex="0" />
    <BlazorWebView x:Name="blazorWebView" ZIndex="1" VerticalOptions="End" HeightRequest="160" HostPage="wwwroot/index.html" BackgroundColor="Transparent" BlazorWebViewInitialized="WebViewInitialized">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
    </Grid>

</ContentPage>
